# ~/.zshrc (macOS)

# Homebrew PATH
if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# PATH extras
# /usr/local/bin covers ollama (ollama.com) and code (VSCode ARM installer)
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# Auto-start tmux when opening Ghostty — attach existing session or create new
if [ -z "$TMUX" ] && [ -n "$GHOSTTY_RESOURCES_DIR" ]; then
    exec tmux new-session -A -s main
fi

# Editor
export EDITOR=vim
export VISUAL=vim

# Prevent venv from overwriting our custom prompt
export VIRTUAL_ENV_DISABLE_PROMPT=1

# History
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS    # remove any older copy when a duplicate is added
setopt HIST_SAVE_NO_DUPS       # don't write duplicates to the history file on disk
setopt HIST_FIND_NO_DUPS       # skip duplicates when navigating with ↑/↓
setopt HIST_IGNORE_SPACE       # don't record commands prefixed with a space
setopt SHARE_HISTORY           # share history across all open shells in real time
setopt APPEND_HISTORY          # append to history file on exit (don't overwrite)
setopt EXTENDED_HISTORY        # save timestamp + elapsed time with each entry
setopt INTERACTIVE_COMMENTS    # allow # comments in interactive shell

# Completion
autoload -Uz compinit

if type brew &>/dev/null; then
    FPATH="$(brew --prefix)/share/zsh-completions:$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

# Rebuild .zcompdump once per day
if [ "$(find ~/.zcompdump -mtime +1 2>/dev/null)" ]; then
    compinit -i
else
    compinit -C -i
fi

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}No matches for: %d%f'

# zsh-autosuggestions
if [ -f "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
    . "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# zsh-syntax-highlighting (must be sourced last)
if [ -f "$(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
    . "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ls colours
export CLICOLOR=1
export LSCOLORS='ExGxFxDxCxDxDxhbhbExEx'

# Catppuccin Mocha — one palette for the whole terminal UI. Every badge
# background is its Mocha accent blended 30% into the Base #1e1e2e terminal
# background, so all badges share the same undertone and visual weight; all
# badge text is the bright neutral Text colour for crystal-clear contrast
# against every tinted background.
# (tmux uses these exact values too — see tmux/tmux.conf.)
_OVERLAY='#6c7086'   # Overlay0 (corners / connectors)
_TEXT='#cdd6f4'      # Text     (not-git badge text)

_GREEN='#a6e3a1'     # Green    ([shell] text / user segment / exit ok)
_GREEN_BG='#475950'  # Green bg    (user segment)
_RED='#f38ba8'       # Red      (root / disconnected)
_RED_BG='#5e3f53'    # Red bg      (root / disconnected segment)
_BLUE='#89b4fa'      # Blue     (path segment)
_BLUE_BG='#3e4b6b'   # Blue bg     (path segment)
_MAUVE='#cba6f7'     # Mauve    (venv segment)
_MAUVE_BG='#52476a'  # Mauve bg    (venv segment)
_PEACH='#fab387'     # Peach    (git branch segment)
_PEACH_BG='#604b49'  # Peach bg    (git branch segment)
_LAVENDER='#b4befe'  # Lavender (local time segment)
_LAVENDER_BG='#4b4e6c' # Lavender bg (local time segment)
_TEAL='#94e2d5'      # Teal     (UTC time segment)
_TEAL_BG='#415960'   # Teal bg     (UTC time segment)
_SKY='#89dceb'       # Sky      (kubectl context segment)
_SKY_BG='#3e5767'    # Sky bg      (kubectl context segment)
_OVERLAY_BG='#353748' # Overlay bg  (not-git segment)

# Powerline glyphs — require a Nerd Font (see README "Fonts" section)
_SEP=''             # solid right-pointing segment separator
_BRANCH=''          # git branch icon

# Prompt — two connected lines. [shell] is plain text; everything from
# user@host to UTC time is a continuous bar of dark-tinted badge segments
# with bright accent-coloured text:
#   ╭─ [zsh]  user@host  k8s:cluster  /path  branch  Local ...  UTC ...
#   ╰─ $ (green ok / red error)   ← command starts here
setopt PROMPT_SUBST

_zsh_prompt() {
    local exit_ok=$?
    local sym sym_col local_time utc_time kctx kctx_bg
    local git_branch git_bg git_text user_bg user_fg venv_name
    local line1 prev_bg i
    local -a seg_bg seg_fg seg_text

    local_time=$(date '+%Y-%m-%d %H:%M:%S')
    utc_time=$(date -u '+%Y-%m-%d %H:%M:%S')

    # git branch segment — current branch/commit, or "not git repo" outside a repo
    if git -C "$PWD" rev-parse --is-inside-work-tree &>/dev/null; then
        git_branch=$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$PWD" rev-parse --short HEAD 2>/dev/null)
        git_bg="$_PEACH_BG"
        git_text="${_BRANCH} ${git_branch}"
    else
        git_bg="$_OVERLAY_BG"
        git_text="not git repo"
    fi

    # user/host segment colour — root = red alarm
    if [ "$(id -u)" -eq 0 ]; then
        sym='#'
        user_bg="$_RED_BG"
        user_fg="$_RED"
    else
        sym='$'
        user_bg="$_GREEN_BG"
        user_fg="$_GREEN"
    fi

    # kubectl current context — shows live cluster or "disconnected"
    if command -v kubectl &>/dev/null; then
        kctx=$(kubectl config current-context 2>/dev/null)
        if [ -n "$kctx" ]; then
            kctx_bg="$_SKY_BG"
        else
            kctx="disconnected"
            kctx_bg="$_RED_BG"
        fi
    else
        kctx="disconnected"
        kctx_bg="$_RED_BG"
    fi

    if [ $exit_ok -eq 0 ]; then
        sym_col="$_GREEN"
    else
        sym_col="$_RED"
    fi

    # badge segments — venv (optional), user@host, k8s, path, git, Local, UTC
    seg_bg=() seg_fg=() seg_text=()

    if [ -n "$VIRTUAL_ENV" ]; then
        venv_name="${VIRTUAL_ENV_PROMPT:-$(basename "$VIRTUAL_ENV")}"
        seg_bg+=("$_MAUVE_BG"); seg_fg+=("$_TEXT"); seg_text+=(" ${venv_name} ")
    fi
    seg_bg+=("$user_bg");      seg_fg+=("$_TEXT");   seg_text+=(" %n@%m ")
    seg_bg+=("$kctx_bg");      seg_fg+=("$_TEXT");   seg_text+=(" k8s:${kctx} ")
    seg_bg+=("$_BLUE_BG");     seg_fg+=("$_TEXT");     seg_text+=(" %~ ")
    seg_bg+=("$git_bg");       seg_fg+=("$_TEXT");    seg_text+=(" ${git_text} ")
    seg_bg+=("$_LAVENDER_BG"); seg_fg+=("$_TEXT"); seg_text+=(" Local ${local_time} ")
    seg_bg+=("$_TEAL_BG");     seg_fg+=("$_TEXT");     seg_text+=(" UTC ${utc_time} ")

    # ╭─ [shell] tag — plain text, not part of the highlighted bar
    line1="%F{$_OVERLAY}╭─%f %F{$user_fg}[zsh]%f "

    prev_bg=""
    for i in {1..${#seg_bg}}; do
        if [ -n "$prev_bg" ]; then
            line1+="%K{${seg_bg[$i]}}%F{$prev_bg}${_SEP}%f"
        else
            line1+="%K{${seg_bg[$i]}}"
        fi
        line1+="%F{${seg_fg[$i]}}${seg_text[$i]}"
        prev_bg="${seg_bg[$i]}"
    done
    line1+="%k%F{$prev_bg}${_SEP}%f"

    PROMPT="${line1}
%F{$_OVERLAY}╰─%f %F{$sym_col}${sym}%f "
}

precmd_functions+=(_zsh_prompt)

# Key bindings
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Aliases
if [ -f ~/.zsh_aliases ]; then
    . ~/.zsh_aliases
fi

# tmux shortcut
alias t='tmux'

# CLI tool completions — add tools here that support "tool completion zsh"
_zsh_load_completions() {
    local tool output
    for tool in kubectl helm flux kind k3d docker; do
        if command -v "$tool" &>/dev/null; then
            output=$("$tool" completion zsh 2>/dev/null)
            [ -n "$output" ] && eval "$output"
        fi
    done
    # extend completion to the k alias for kubectl
    command -v kubectl &>/dev/null && compdef k=kubectl
}
_zsh_load_completions
unset -f _zsh_load_completions

# Ollama completion — manual definition with live model name completion
if command -v ollama &>/dev/null; then
    _ollama() {
        local state line
        _arguments -C \
            '1:command:->command' \
            '*:args:->args'
        case $state in
            command)
                local -a cmds
                cmds=(
                    'serve:Start ollama server'
                    'create:Create a model from a Modelfile'
                    'show:Show information for a model'
                    'run:Run a model'
                    'pull:Pull a model from a registry'
                    'push:Push a model to a registry'
                    'list:List models'
                    'ps:List running models'
                    'cp:Copy a model'
                    'rm:Remove a model'
                    'help:Help about any command'
                )
                _describe 'command' cmds
                ;;
            args)
                case $words[2] in
                    run|show|cp|rm|push)
                        local -a models
                        models=(${(f)"$(ollama list 2>/dev/null | awk 'NR>1 {print $1}')"})
                        _describe 'model' models
                        ;;
                esac
                ;;
        esac
    }
    compdef _ollama ollama
fi
