# ~/.bashrc (macOS)

# If not running interactively, bail
case $- in
    *i*) ;;
      *) return;;
esac

# History — full deduplication (ignoredups + erasedups)
HISTCONTROL=ignoredups:erasedups
HISTSIZE=100000
HISTFILESIZE=200000
shopt -s histappend    # append to history file on exit (don't overwrite)
shopt -s checkwinsize          # update LINES/COLUMNS after each command

# Homebrew PATH
if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# PATH extras
# /usr/local/bin covers ollama (ollama.com) and code (VSCode ARM installer)
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# Auto-start tmux when opening Ghostty — attach existing session or create new
if [ -z "$TMUX" ] && [ -n "$GHOSTTY_RESOURCES_DIR" ]; then
    exec tmux new-session -A -s main
fi

# Editor
export EDITOR=vim
export VISUAL=vim

# Prevent venv from overwriting our custom prompt
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Catppuccin Mocha — one palette for the whole terminal UI. Every badge
# background is its Mocha accent blended 30% into the Base #1e1e2e terminal
# background, so all badges share the same undertone and visual weight; all
# badge text is the bright neutral Text colour for crystal-clear contrast
# against every tinted background.
# (tmux uses these exact values too — see tmux/tmux.conf.)
_OVERLAY='108;112;134'     # Overlay0 (corners / connectors)              #6c7086
_TEXT='205;214;244'        # Text     (not-git badge text)                #cdd6f4

_GREEN='166;227;161'       # Green    ([shell] text / user segment / exit ok) #a6e3a1
_GREEN_BG='71;89;80'       # Green bg    (user segment)                   #475950
_RED='243;139;168'         # Red      (root / disconnected)               #f38ba8
_RED_BG='94;63;83'         # Red bg      (root / disconnected segment)    #5e3f53
_BLUE='137;180;250'        # Blue     (path segment)                      #89b4fa
_BLUE_BG='62;75;107'       # Blue bg     (path segment)                   #3e4b6b
_MAUVE='203;166;247'       # Mauve    (venv segment)                      #cba6f7
_MAUVE_BG='82;71;106'      # Mauve bg    (venv segment)                   #52476a
_PEACH='250;179;135'       # Peach    (git branch segment)                #fab387
_PEACH_BG='96;75;73'       # Peach bg    (git branch segment)             #604b49
_LAVENDER='180;190;254'    # Lavender (local time segment)                #b4befe
_LAVENDER_BG='75;78;108'   # Lavender bg (local time segment)             #4b4e6c
_TEAL='148;226;213'        # Teal     (UTC time segment)                  #94e2d5
_TEAL_BG='65;89;96'        # Teal bg     (UTC time segment)               #415960
_SKY='137;220;235'         # Sky      (kubectl context segment)           #89dceb
_SKY_BG='62;87;103'        # Sky bg      (kubectl context segment)        #3e5767
_OVERLAY_BG='53;55;72'     # Overlay bg  (not-git segment)                #353748
_RST='\[\e[0m\]'

# Powerline glyphs — require a Nerd Font (see README "Fonts" section)
_SEP=''                # solid right-pointing segment separator
_BRANCH=''             # git branch icon

# Prompt — two connected lines. [shell] is plain text; everything from
# user@host to UTC time is a continuous bar of dark-tinted badge segments
# with bright accent-coloured text:
#   ╭─ [bash]  user@host  k8s:cluster  /path  branch  Local ...  UTC ...
#   ╰─ $ (green ok / red error)   ← command starts here
_set_prompt() {
    local exit_code=$?
    local sym sym_col local_time utc_time kctx kctx_bg
    local git_branch git_bg git_text user_bg user_fg venv_name
    local git_dirty git_ab git_stash ab_counts ahead behind stash_count
    local line1 prev_bg i
    local -a seg_bg seg_fg seg_text

    local_time=$(date '+%Y-%m-%d %H:%M:%S')
    utc_time=$(date -u '+%Y-%m-%d %H:%M:%S')

    # git branch segment — current branch/commit, or "not git repo" outside a repo
    if git -C "$PWD" rev-parse --is-inside-work-tree &>/dev/null; then
        git_branch=$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$PWD" rev-parse --short HEAD 2>/dev/null)
        git_bg="$_PEACH_BG"

        # dirty: * unstaged changes, + staged changes
        git_dirty=""
        git -C "$PWD" diff --quiet 2>/dev/null || git_dirty+="*"
        git -C "$PWD" diff --staged --quiet 2>/dev/null || git_dirty+="+"

        # ahead/behind upstream — rev-list outputs tab-separated; awk normalises
        git_ab=""
        ab_counts=$(git -C "$PWD" rev-list --left-right --count "HEAD...@{upstream}" 2>/dev/null | awk '{print $1, $2}')
        if [ -n "$ab_counts" ]; then
            ahead="${ab_counts%% *}"
            behind="${ab_counts##* }"
            [ "$ahead" -gt 0 ] && git_ab+=" ⇡${ahead}"
            [ "$behind" -gt 0 ] && git_ab+=" ⇣${behind}"
        fi

        # stash count — awk strips leading spaces from wc -l on macOS
        git_stash=""
        stash_count=$(git -C "$PWD" stash list 2>/dev/null | wc -l | awk '{print $1}')
        [ "$stash_count" -gt 0 ] && git_stash=" {${stash_count}}"

        git_text="${_BRANCH} ${git_branch}${git_dirty}${git_ab}${git_stash}"
    else
        git_bg="$_OVERLAY_BG"
        git_text="not git repo"
    fi

    # user/host segment colour — root = red alarm
    if [ "$(id -u)" -eq 0 ]; then
        sym='#'
        user_bg="$_RED_BG"
        user_fg="$_RED"
    else
        sym='$'
        user_bg="$_GREEN_BG"
        user_fg="$_GREEN"
    fi

    # kubectl current context — shows live cluster or "disconnected"
    if command -v kubectl &>/dev/null; then
        kctx=$(kubectl config current-context 2>/dev/null)
        if [ -n "$kctx" ]; then
            kctx_bg="$_SKY_BG"
        else
            kctx="disconnected"
            kctx_bg="$_RED_BG"
        fi
    else
        kctx="disconnected"
        kctx_bg="$_RED_BG"
    fi

    if [ $exit_code -eq 0 ]; then
        sym_col="$_GREEN"
    else
        sym_col="$_RED"
    fi

    # badge segments — venv (optional), user@host, k8s, path, git, Local, UTC
    seg_bg=() seg_fg=() seg_text=()

    if [ -n "$VIRTUAL_ENV" ]; then
        venv_name="${VIRTUAL_ENV_PROMPT:-$(basename "$VIRTUAL_ENV")}"
        seg_bg+=("$_MAUVE_BG"); seg_fg+=("$_TEXT"); seg_text+=(" ${venv_name} ")
    fi
    seg_bg+=("$user_bg");      seg_fg+=("$_TEXT");   seg_text+=(" \u@\h ")
    seg_bg+=("$kctx_bg");      seg_fg+=("$_TEXT");   seg_text+=(" k8s:${kctx} ")
    seg_bg+=("$git_bg");       seg_fg+=("$_TEXT");    seg_text+=(" ${git_text} ")
    seg_bg+=("$_BLUE_BG");     seg_fg+=("$_TEXT");     seg_text+=(" \w ")
    seg_bg+=("$_LAVENDER_BG"); seg_fg+=("$_TEXT"); seg_text+=(" Local ${local_time} ")
    seg_bg+=("$_TEAL_BG");     seg_fg+=("$_TEXT");     seg_text+=(" UTC ${utc_time} ")

    # ╭─ [shell] tag — plain text, not part of the highlighted bar
    line1="\[\e[38;2;${_OVERLAY}m\]╭─${_RST} \[\e[38;2;${user_fg}m\][bash]${_RST} "

    prev_bg=""
    for i in "${!seg_bg[@]}"; do
        if [ -n "$prev_bg" ]; then
            line1+="\[\e[48;2;${seg_bg[$i]}m\]\[\e[38;2;${prev_bg}m\]${_SEP}"
        else
            line1+="\[\e[48;2;${seg_bg[$i]}m\]"
        fi
        line1+="\[\e[38;2;${seg_fg[$i]}m\]${seg_text[$i]}"
        prev_bg="${seg_bg[$i]}"
    done
    line1+="\[\e[49m\]\[\e[38;2;${prev_bg}m\]${_SEP}${_RST}"

    PS1="${line1}\n\[\e[38;2;${_OVERLAY}m\]╰─${_RST} \[\e[38;2;${sym_col}m\]${sym}${_RST} "
}
PROMPT_COMMAND='_set_prompt'

# ls colours
export CLICOLOR=1
export LSCOLORS='ExGxFxDxCxDxDxhbhbExEx'

# Readline — cleaner completion display
bind 'set show-all-if-ambiguous on'    # single Tab shows all matches
bind 'set completion-ignore-case on'   # case-insensitive matching
bind 'set mark-symlinked-directories on'
bind 'set colored-stats on'            # colour files by type in completion list
bind 'set colored-completion-prefix on'

# bash-completion@2
if [ -r "$(brew --prefix 2>/dev/null)/etc/profile.d/bash_completion.sh" ]; then
    . "$(brew --prefix)/etc/profile.d/bash_completion.sh"
fi

# Strip tab-separated descriptions from COMPREPLY so completions show as a
# plain list (like ollama) rather than a columnar table with descriptions
# (like the default docker/cobra output).
_strip_comp_descriptions() {
    local i
    for i in "${!COMPREPLY[@]}"; do
        COMPREPLY[$i]="${COMPREPLY[$i]%%$'\t'*}"
    done
}

# CLI tool completions — add tools here that support "tool completion bash"
_bash_load_completions() {
    local tool output comp_fn wrapper_fn
    for tool in kubectl helm flux kind k3d docker; do
        if command -v "$tool" &>/dev/null; then
            output=$("$tool" completion bash 2>/dev/null)
            if [ -n "$output" ]; then
                eval "$output"
                # Wrap the registered completion function to strip descriptions
                comp_fn=$(complete -p "$tool" 2>/dev/null | sed -n 's/.*-F \([^ ]*\).*/\1/p')
                if [ -n "$comp_fn" ]; then
                    wrapper_fn="_nodesc_${tool}"
                    eval "
${wrapper_fn}() {
    ${comp_fn} \"\$@\"
    _strip_comp_descriptions
}
"
                    complete -F "$wrapper_fn" "$tool"
                fi
            fi
        fi
    done
    # extend completion to the k alias for kubectl
    command -v kubectl &>/dev/null && complete -o default -F __start_kubectl k
}
_bash_load_completions
unset -f _bash_load_completions

# Ollama completion — manual definition with live model name completion
if command -v ollama &>/dev/null; then
    _ollama_bash() {
        local cur prev
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        local subcmds="serve create show run pull push list ps cp rm help"
        if [ "$COMP_CWORD" -eq 1 ]; then
            COMPREPLY=($(compgen -W "$subcmds" -- "$cur"))
            return
        fi
        case "$prev" in
            run|show|cp|rm|push)
                local models
                models=$(ollama list 2>/dev/null | awk 'NR>1 {print $1}')
                COMPREPLY=($(compgen -W "$models" -- "$cur"))
                ;;
        esac
    }
    complete -F _ollama_bash ollama
fi

# Aliases
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# tmux shortcut
alias t='tmux'
