# Ghostty config — tmux handles panes and scrollback

# Font — JetBrainsMono Nerd Font Mono provides the powerline glyphs used by
# the shell prompt segments (separators + git branch icon) with fixed-width
# glyph cells, which the proportional "Nerd Font" variant lacks. See README
# "Fonts". Font changes require a full Ghostty restart (Cmd+Q), not just a
# config reload (Cmd+Shift+,).
font-family = JetBrainsMono Nerd Font Mono
# font-family = SF Mono — built-in macOS font, swap in to test if the Nerd
# Font isn't visibly applying (powerline glyphs will show as boxes/"?" with
# this one, since it isn't a Nerd Font)
font-size = 12

# Catppuccin Mocha
background = 1e1e2e
foreground = cdd6f4
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

background-opacity = 1
background-blur = false
macos-icon = paper

# Padding
window-padding-x = 1
window-padding-y = 1

# Title bar — requires full Ghostty restart to apply
macos-titlebar-style = hidden

# Vertical bar cursor
cursor-style = bar
cursor-style-blink = true

# Disabled — use tmux copy-mode for scrolling
scrollback-limit = 0

# Required for tmux Option+WASD and Option+1-7 bindings
macos-option-as-alt = true

# Disable built-in splits — tmux handles all panes
keybind = cmd+d=ignore
keybind = cmd+shift+d=ignore
